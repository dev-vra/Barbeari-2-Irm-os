generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────

enum Role {
  CLIENT
  ADMIN
}

enum AppointmentStatus {
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  REFUNDED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  CASH
}

enum ProductType {
  HAIRCARE
  BARBERING
  SKINCARE
  ACCESSORY
  OTHER
}

enum CommissionType {
  SERVICE
  PRODUCT
}

// ─────────────────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────────────────

model User {
  id           String    @id @default(uuid())
  name         String
  cpf          String    @unique
  email        String    @unique
  passwordHash String
  role         Role      @default(CLIENT)
  birthdate    DateTime?
  phone        String?
  avatarUrl    String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  appointments  Appointment[]
  productSales  ProductSale[]
  refreshTokens RefreshToken[]

  @@index([cpf])
  @@index([email])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────
// PROFESSIONAL
// ─────────────────────────────────────────────────────────

model Professional {
  id                   String   @id @default(uuid())
  name                 String
  description          String?
  photoUrl             String?
  serviceCommissionPct Decimal  @default(0) @db.Decimal(5, 2)
  productCommissionPct Decimal  @default(0) @db.Decimal(5, 2)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  professionalServices ProfessionalService[]
  appointments         Appointment[]
  productSales         ProductSale[]
  schedules            Schedule[]
  commissions          Commission[]

  @@map("professionals")
}

// ─────────────────────────────────────────────────────────
// SERVICE
// ─────────────────────────────────────────────────────────

model Service {
  id          String   @id @default(uuid())
  name        String
  description String?
  durationMin Int
  price       Decimal  @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  professionalServices ProfessionalService[]
  appointments         Appointment[]

  @@map("services")
}

// ─────────────────────────────────────────────────────────
// PROFESSIONAL <-> SERVICE
// ─────────────────────────────────────────────────────────

model ProfessionalService {
  id             String       @id @default(uuid())
  professionalId String
  serviceId      String
  commissionPct  Decimal      @db.Decimal(5, 2)
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([professionalId, serviceId])
  @@map("professional_services")
}

// ─────────────────────────────────────────────────────────
// PRODUCT
// ─────────────────────────────────────────────────────────

model Product {
  id            String      @id @default(uuid())
  name          String
  type          ProductType
  description   String?
  stock         Int         @default(0)
  cost          Decimal     @db.Decimal(10, 2)
  salePrice     Decimal     @db.Decimal(10, 2)
  commissionPct Decimal     @default(0) @db.Decimal(5, 2)
  supplier      String?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  productSales ProductSale[]

  @@map("products")
}

// ─────────────────────────────────────────────────────────
// APPOINTMENT
// ─────────────────────────────────────────────────────────

model Appointment {
  id             String            @id @default(uuid())
  clientId       String
  professionalId String
  serviceId      String
  scheduledAt    DateTime
  endsAt         DateTime
  status         AppointmentStatus @default(PENDING_PAYMENT)
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  client       User         @relation(fields: [clientId], references: [id])
  professional Professional @relation(fields: [professionalId], references: [id])
  service      Service      @relation(fields: [serviceId], references: [id])
  payment      Payment?
  commissions  Commission[]

  @@index([professionalId, scheduledAt])
  @@index([clientId])
  @@map("appointments")
}

// ─────────────────────────────────────────────────────────
// PAYMENT
// ─────────────────────────────────────────────────────────

model Payment {
  id            String        @id @default(uuid())
  appointmentId String        @unique
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod @default(PIX)
  status        PaymentStatus @default(PENDING)
  mercadopagoId String?       @unique
  preferenceId  String?
  externalRef   String?       @unique
  expiresAt     DateTime
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@index([status, expiresAt])
  @@map("payments")
}

// ─────────────────────────────────────────────────────────
// PRODUCT SALE
// ─────────────────────────────────────────────────────────

model ProductSale {
  id             String   @id @default(uuid())
  clientId       String
  professionalId String
  productId      String
  quantity       Int
  unitPrice      Decimal  @db.Decimal(10, 2)
  totalPrice     Decimal  @db.Decimal(10, 2)
  soldAt         DateTime @default(now())

  client       User         @relation(fields: [clientId], references: [id])
  professional Professional @relation(fields: [professionalId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])
  commissions  Commission[]

  @@map("product_sales")
}

// ─────────────────────────────────────────────────────────
// COMMISSION
// ─────────────────────────────────────────────────────────

model Commission {
  id             String         @id @default(uuid())
  professionalId String
  type           CommissionType
  appointmentId  String?
  productSaleId  String?
  amount         Decimal        @db.Decimal(10, 2)
  paidAt         DateTime?
  createdAt      DateTime       @default(now())

  professional Professional @relation(fields: [professionalId], references: [id])
  appointment  Appointment?  @relation(fields: [appointmentId], references: [id])
  productSale  ProductSale?  @relation(fields: [productSaleId], references: [id])

  @@index([professionalId])
  @@map("commissions")
}

// ─────────────────────────────────────────────────────────
// SCHEDULE
// ─────────────────────────────────────────────────────────

model Schedule {
  id             String       @id @default(uuid())
  professionalId String
  dayOfWeek      Int
  startTime      String
  endTime        String
  isActive       Boolean      @default(true)
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([professionalId, dayOfWeek])
  @@map("schedules")
}
